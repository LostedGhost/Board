# Copier en .env (jamais versionné) et adapter.

DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_NAME=luluboard
DATABASE_USER=luluboard
DATABASE_PASSWORD=a-remplacer
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis (Memurai en local sous Windows)
REDIS_URL=redis://localhost:6379/0

# Stockage des fichiers : false = LuluFiles, true = API Bot Telegram en direct
FILES_USE_DIRECT_TELEGRAM=true
LULUFILES_BASE_URL=https://lulufiles-api.onrender.com
LULUFILES_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Version minimale des apps clientes acceptée par l'API (I10)
MIN_APP_VERSION=0.1.0

# E-mails (console en local)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LuluBoard <no-reply@luluboard.local>
# Production : clé API Brevo (envoi HTTP, remplace EMAIL_BACKEND)
BREVO_API_KEY=

# Connexion Google : identifiants OAuth (web, Android, iOS), séparés par des virgules
GOOGLE_CLIENT_IDS=

# Celery : true = tâches exécutées immédiatement, sans worker (local uniquement)
CELERY_TASK_ALWAYS_EAGER=true
# LuluFiles autorise-t-il l'origine LuluBoard en CORS ? (sinon, téléchargements via notre serveur)
LULUFILES_CORS_OUVERT=false
FICHIERS_DOSSIER_TEMPORAIRE=

# Notifications push (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_FICHIER_COMPTE_SERVICE=
# Adresse qui reçoit les demandes de support
SUPPORT_EMAIL=

# Origines autorisées pour l'app web (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
